# --- required in both modes -------------------------------------------------
PAPERLESS_BASE_URL=https://paperless.applications.svc.cluster.local

# AUTH_MODE=oidc (default) — every call acts as the calling person.
# AUTH_MODE=token — one shared PAPERLESS_API_TOKEN for everyone (single-user,
# for people without an IdP; see README Security section).
AUTH_MODE=oidc

# --- AUTH_MODE=oidc: inbound token verification (all required) -------------
OIDC_JWKS_URI=https://keycloak.example.com/realms/home/protocol/openid-connect/certs
OIDC_ISSUER=https://keycloak.example.com/realms/home
OIDC_AUDIENCE=paperless
MCP_BASE_URL=https://paperless-mcp.example.com

# Claim used to label the caller for the per-person outbox directory and
# debug logging. Identity towards Paperless itself comes from the token
# exchange below, not from this claim.
OIDC_USERNAME_CLAIM=preferred_username

# --- AUTH_MODE=oidc: Keycloak -> Paperless token exchange (all required) ---
# Keycloak's token endpoint; must have "Standard token exchange" enabled for
# EXCHANGE_CLIENT_ID.
OIDC_TOKEN_ENDPOINT=https://keycloak.example.com/realms/home/protocol/openid-connect/token
# The Paperless OIDC client in Keycloak — confidential, "Standard token
# exchange" capability enabled, used both as the token-exchange client
# (client_secret_basic) and as the client_id sent to Paperless' headless
# allauth login.
EXCHANGE_CLIENT_ID=paperless
EXCHANGE_CLIENT_SECRET=your-keycloak-client-secret

# Paperless allauth provider id for the Keycloak connection (must match the
# provider id configured in Paperless' PAPERLESS_SOCIALACCOUNT_PROVIDERS).
PAPERLESS_OIDC_PROVIDER_ID=keycloak

# How long an exchanged Paperless DRF token is cached in memory, per person.
PAPERLESS_TOKEN_CACHE_SECONDS=3600

# --- AUTH_MODE=token only ----------------------------------------------------
# PAPERLESS_API_TOKEN=your-paperless-api-token

# --- optional, both modes ----------------------------------------------------
# Sent as the Host header on every Paperless request — needed when
# PAPERLESS_BASE_URL is an in-cluster service URL but Paperless' ALLOWED_HOSTS
# is the public name.
# PAPERLESS_HOST_HEADER=paperless.example.com
# Browser-facing Paperless URL; only used for the `url` deep link returned by
# paperless_documents_thumbnail_image (omitted when unset).
# PAPERLESS_PUBLIC_URL=https://paperless.example.com
HTTP_TIMEOUT_SECONDS=15
MAX_PAGE_SIZE=100
PAPERLESS_OUTBOX_DIR=/home/mcp/outbox
MCP_HOST=0.0.0.0
MCP_PORT=8000
